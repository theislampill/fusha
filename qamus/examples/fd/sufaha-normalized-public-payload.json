      "surface": "ال",
      "label": "Article",
      "visual_equivalent": "[ART]",
      "sarf": "Ṣarf: definite article; it has no lexical root.",
      "nahw": "Naḥw: the article marks definiteness on the noun.",
      "learner_text": "ال marks the noun as definite.",
