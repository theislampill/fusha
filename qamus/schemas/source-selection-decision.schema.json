{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theIslampill/fusha/qamus/schemas/source-selection-decision.schema.json",
  "title": "Qamus transclusion source-selection decision",
  "description": "One decision row: for a surface form with several authored candidate analyses, which class-signature was chosen as the transclusion source, and on what basis. Gated so an over-segmented minority analysis can never out-rank the canonical/majority one (the L15 canary lesson: Musa/alladhi).",
  "type": "object",
  "required": ["schema", "surface", "surface_norm", "candidates", "chosen_signature", "selection_basis", "public_safe"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "string", "const": "qamus.source_selection_decision.v1" },
    "surface": { "type": "string", "minLength": 1 },
    "surface_norm": { "type": "string", "minLength": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class_signature", "count"],
        "additionalProperties": false,
        "properties": {
          "class_signature": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "count": { "type": "integer", "minimum": 1 },
          "source_loc": { "type": ["string", "null"], "pattern": "^\\d{1,3}:\\d{1,3}:\\d{1,3}$" }
        }
      }
    },
    "chosen_signature": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "selection_basis": {
      "type": "string",
      "enum": ["source_address_exact", "majority_class_signature", "canonical_allowlist"]
    },
    "chosen_source_loc": { "type": ["string", "null"], "pattern": "^\\d{1,3}:\\d{1,3}:\\d{1,3}$" },
    "target_loc": { "type": ["string", "null"], "pattern": "^\\d{1,3}:\\d{1,3}:\\d{1,3}$" },
    "fanout_allowed": { "type": "boolean" },
    "public_safe": { "type": "boolean" },
    "note": { "type": ["string", "null"] }
  }
}
