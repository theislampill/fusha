{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theIslampill/fusha/qamus/schemas/unresolved-language-map.schema.json",
  "title": "Public unresolved-language mapping v1",
  "description": "Typed mapping from internal unresolved status IDs to plain-English learner statements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "entries"],
  "properties": {
    "schema": {"const": "qamus.unresolved_language_map.v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "language", "learner_statement", "public"],
        "properties": {
          "status": {"type": "string", "enum": ["unresolved", "source_gap", "producer_pending", "syntax_pending", "blocked"]},
          "language": {"const": "en"},
          "learner_statement": {"type": "string", "minLength": 1},
          "public": {"const": true}
        }
      }
    }
  }
}
