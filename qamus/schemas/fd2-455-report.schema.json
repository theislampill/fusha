{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theIslampill/fusha/qamus/schemas/fd2-455-report.schema.json",
  "title": "FD2 calibrated-producer 455-row rerun report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_version",
    "candidate_only",
    "verified_row_count",
    "input_verdict_count",
    "metrics",
    "movement",
    "flag_matrix",
    "primary_blocker_counts",
    "producer_reach",
    "occurrence_index",
    "producer_lineage",
    "scope",
    "metric_definitions",
    "verdicts_artifact",
    "verdicts_meta_artifact",
    "input_artifacts",
    "live_mutation_allowed"
  ],
  "properties": {
    "schema": {"const": "qamus.fd2.455_rerun_report.v1"},
    "report_version": {"const": "1.0.0"},
    "candidate_only": {"const": true},
    "verified_row_count": {"const": 455},
    "input_verdict_count": {"const": 575},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows with complete morphology facts",
        "rows with complete naḥw facts",
        "rows with both",
        "rows generating at-rest projection",
        "rows generating rich Ṣarf",
        "rows generating rich Naḥw",
        "rows generating both compact and expanded views",
        "rows with repeated-appearance parity",
        "unresolved rows by exact blocker",
        "source/scholar queues",
        "reconstruction failures",
        "projection conflicts",
        "newly discovered producer defects"
      ],
      "properties": {
        "rows with complete morphology facts": {"type": "integer", "minimum": 0},
        "rows with complete naḥw facts": {"type": "integer", "minimum": 0},
        "rows with both": {"type": "integer", "minimum": 0},
        "rows generating at-rest projection": {"type": "integer", "minimum": 0},
        "rows generating rich Ṣarf": {"type": "integer", "minimum": 0},
        "rows generating rich Naḥw": {"type": "integer", "minimum": 0},
        "rows generating both compact and expanded views": {"type": "integer", "minimum": 0},
        "rows with repeated-appearance parity": {"type": "integer", "minimum": 0},
        "unresolved rows by exact blocker": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "source/scholar queues": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "scholar", "both", "routes"],
          "properties": {
            "source": {"type": "integer", "minimum": 0},
            "scholar": {"type": "integer", "minimum": 0},
            "both": {"type": "integer", "minimum": 0},
            "routes": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
          }
        },
        "reconstruction failures": {"type": "integer", "minimum": 0},
        "projection conflicts": {"type": "integer", "minimum": 0},
        "newly discovered producer defects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "items"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "items": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "delta", "interpretation"],
      "properties": {
        "before": {"$ref": "#/$defs/movement_values"},
        "after": {"$ref": "#/$defs/movement_values"},
        "delta": {"$ref": "#/$defs/movement_values"},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "flag_matrix": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "primary_blocker_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "producer_reach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "family_counts", "F-B", "F-C"],
      "properties": {
        "rows": {"type": "integer", "minimum": 0},
        "family_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "F-B": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "F-C": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "occurrence_index": {"type": "object", "additionalProperties": true},
    "producer_lineage": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "scope": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "metric_definitions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "verdicts_artifact": {"const": "qamus/reports/calibration-455/fd2-455-verdicts.jsonl"},
    "verdicts_meta_artifact": {"const": "qamus/reports/calibration-455/fd2-455-verdicts.meta.json"},
    "input_artifacts": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "live_mutation_allowed": {"const": false}
  },
  "$defs": {
    "movement_values": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows needing F-B",
        "rows needing F-C",
        "rows lacking learner-language",
        "rows with repeated-appearance coverage"
      ],
      "properties": {
        "rows needing F-B": {"type": "integer"},
        "rows needing F-C": {"type": "integer"},
        "rows lacking learner-language": {"type": "integer"},
        "rows with repeated-appearance coverage": {"type": "integer"}
      }
    }
  }
}
