{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theIslampill/fusha/qamus/schemas/two-vote-artifact.schema.json",
  "title": "Qamus two-vote artifact bundle v1",
  "description": "Reconstructible evidence contract behind any two_vote / bulk_two_vote_certified claim: two independent vote records plus agreement computed on conclusion AND grammatical reason, never on gloss text. Historical claims without artifacts are representable only as two_vote_claimed_unverified and are never fabricated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_id",
    "claimed_decision_state",
    "claim_state",
    "occurrence",
    "votes",
    "agreement",
    "reclassification",
    "votes_fabricated"
  ],
  "properties": {
    "schema": {"const": "qamus.two_vote_artifact.v1"},
    "artifact_id": {
      "type": "string",
      "pattern": "^two-vote-artifact:quran_[0-9]{1,3}_[0-9]{1,3}_[0-9]{1,3}(:[A-Za-z0-9._-]+)?$"
    },
    "claimed_decision_state": {
      "type": "string",
      "enum": ["two_vote", "bulk_two_vote_certified"]
    },
    "claim_state": {
      "type": "string",
      "enum": ["two_vote_verified", "two_vote_disagreement", "two_vote_claimed_unverified"]
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quran_loc", "wbw_loc", "surface"],
      "properties": {
        "quran_loc": {"type": "string", "pattern": "^quran:[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
        "wbw_loc": {"type": "string", "pattern": "^wbw:[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
        "surface": {"type": "string", "minLength": 1}
      }
    },
    "votes": {
      "type": "array",
      "items": {"$ref": "#/$defs/vote_record"},
      "maxItems": 2
    },
    "agreement": {
      "oneOf": [{"$ref": "#/$defs/agreement"}, {"type": "null"}]
    },
    "reclassification": {
      "oneOf": [{"$ref": "#/$defs/reclassification"}, {"type": "null"}]
    },
    "votes_fabricated": {"const": false}
  },
  "$defs": {
    "vote_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vote_id",
        "reviewer",
        "timestamp",
        "occurrence",
        "segmentation",
        "lexical_identity",
        "root",
        "form",
        "conclusion",
        "grammatical_reason",
        "reason_key",
        "unresolved_points"
      ],
      "properties": {
        "vote_id": {"type": "string", "pattern": "^vote:[A-Za-z0-9._:-]+$"},
        "reviewer": {"$ref": "#/$defs/reviewer_provenance"},
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "occurrence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quran_loc", "wbw_loc", "surface"],
          "properties": {
            "quran_loc": {"type": "string", "pattern": "^quran:[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
            "wbw_loc": {"type": "string", "pattern": "^wbw:[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
            "surface": {"type": "string", "minLength": 1}
          }
        },
        "segmentation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segment_surface", "role"],
            "properties": {
              "segment_surface": {"type": "string", "minLength": 1},
              "role": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]*$"}
            }
          }
        },
        "lexical_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entry_id", "lemma_ar"],
          "properties": {
            "entry_id": {"type": ["string", "null"], "minLength": 1},
            "lemma_ar": {"type": "string", "minLength": 1}
          }
        },
        "root": {"type": ["string", "null"], "minLength": 1},
        "form": {"type": ["string", "null"], "minLength": 1},
        "conclusion": {"$ref": "#/$defs/conclusion"},
        "grammatical_reason": {"type": "string", "minLength": 1},
        "reason_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "gloss": {"type": "string"},
        "unresolved_points": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviewer_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "engine", "model", "lane"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1},
        "engine": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "lane": {"type": "string", "minLength": 1}
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextual_function",
        "governor",
        "governed_expression",
        "case_or_mood",
        "attachment",
        "referent"
      ],
      "properties": {
        "contextual_function": {"type": "string", "minLength": 1},
        "governor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["surface", "relation"],
              "properties": {
                "loc": {"type": ["string", "null"], "pattern": "^(quran|wbw):[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
                "surface": {"type": "string", "minLength": 1},
                "relation": {"type": "string", "minLength": 1}
              }
            },
            {"type": "null"}
          ]
        },
        "governed_expression": {"type": ["string", "null"], "minLength": 1},
        "case_or_mood": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "sign", "sign_visibility"],
          "properties": {
            "value": {"type": ["string", "null"], "minLength": 1},
            "sign": {"type": ["string", "null"], "minLength": 1},
            "sign_visibility": {"type": "string", "enum": ["visible", "estimated", "not_applicable"]}
          }
        },
        "attachment": {"type": ["string", "null"], "minLength": 1},
        "referent": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion_agrees",
        "reason_agrees",
        "agreement_key",
        "compared_fields",
        "gloss_text_used_for_agreement"
      ],
      "properties": {
        "conclusion_agrees": {"type": "boolean"},
        "reason_agrees": {"type": "boolean"},
        "agreement_key": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "compared_fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "gloss_text_used_for_agreement": {"const": false}
      }
    },
    "reclassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_claim_source", "reason", "reclassified_on"],
      "properties": {
        "original_claim_source": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "reclassified_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    }
  }
}
