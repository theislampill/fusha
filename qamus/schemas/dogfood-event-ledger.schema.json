{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theIslampill/fusha/qamus/schemas/dogfood-event-ledger.schema.json",
  "title": "Qamus dogfood event ledger row v1",
  "description": "One per-event record of the dogfood flywheel loop. A chain of these rows reconstructs how a defect found while dogfooding became typed facts, rules, fixtures, projector/validator changes, skill updates, analogous discoveries, shadow tests, deploys, readbacks, and finally a lesson returned to the playbook. Every row must point at committed repo artifacts; events are evidence, not narrative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "timestamp_utc",
    "tranche",
    "family",
    "loop_stage",
    "occurrence_locs",
    "artifact_paths",
    "counts"
  ],
  "properties": {
    "schema": {"const": "qamus.dogfood_event.v1"},
    "event_id": {
      "type": "string",
      "pattern": "^dogfood-event:[a-z0-9][a-z0-9._:-]*$"
    },
    "timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "tranche": {
      "type": "string",
      "pattern": "^(VN-[0-9]{2}|[a-z0-9][a-z0-9_-]*)$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]*$"
    },
    "loop_stage": {
      "type": "string",
      "enum": [
        "defect_found",
        "certified_or_preserved",
        "typed_fact",
        "rule_change",
        "fixture_added",
        "projector_change",
        "validator_change",
        "skill_update",
        "analogous_discovery",
        "shadow_test",
        "deploy",
        "readback",
        "lesson_return"
      ]
    },
    "occurrence_locs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(quran|wbw):[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"}
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(qamus|nahw|sarf|tools|docs|curriculum|fusha|drills)/[A-Za-z0-9._/-]+$"
      }
    },
    "counts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "caused_by_event": {
      "type": "string",
      "pattern": "^dogfood-event:[a-z0-9][a-z0-9._:-]*$"
    },
    "notes": {"type": "string", "minLength": 1}
  }
}
