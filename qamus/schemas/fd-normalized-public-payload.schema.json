{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theIslampill/fusha/qamus/schemas/fd-normalized-public-payload.schema.json",
  "title": "F-D normalized public payload v1",
  "description": "Fixture-only source-safe normalized payload emitted by the shared F-D compiler.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "payload_version", "src", "kind", "lang", "canonical_identity", "at_rest_spans", "components", "comparison", "rich_explanations", "unresolved_tension", "entry_linkage", "repeated_appearance_parity", "provenance", "font_proof", "exact_reconstruction", "proof_points", "live_mutation_allowed"],
  "properties": {
    "schema": {"const": "qamus.fd.normalized_public_payload.v1"},
    "payload_version": {"const": "1.0.0"},
    "src": {"const": "qamus"},
    "kind": {"const": "authored"},
    "lang": {"const": "en"},
    "canonical_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quran_loc", "wbw_loc", "surface", "entry_id", "card_id"],
      "properties": {
        "quran_loc": {"type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
        "wbw_loc": {"type": "string", "pattern": "^wbw:[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
        "surface": {"type": "string", "minLength": 1},
        "entry_id": {"type": "string", "minLength": 1},
        "card_id": {"type": "string", "minLength": 1}
      }
    },
    "at_rest_spans": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["span_id", "start", "end", "surface", "role", "owner_fact_ids", "visual_equivalent"],
        "properties": {
          "span_id": {"type": "string", "minLength": 1},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "surface": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "owner_fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
          "visual_equivalent": {"type": "string", "minLength": 1}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "span_ids", "surface", "label", "visual_equivalent", "sarf", "nahw", "learner_text", "fact_ids"],
        "properties": {
          "component_id": {"type": "string", "minLength": 1},
          "span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "surface": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "visual_equivalent": {"type": "string", "minLength": 1},
          "sarf": {"type": "string", "minLength": 1},
          "nahw": {"type": "string", "minLength": 1},
          "learner_text": {"type": "string", "minLength": 1},
          "fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
        }
      }
    },
    "comparison": {"type": "object", "minProperties": 1},
    "rich_explanations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sarf", "nahw"],
      "properties": {"sarf": {"type": "string", "minLength": 1}, "nahw": {"type": "string", "minLength": 1}}
    },
    "unresolved_tension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tension_id", "status", "visual_equivalent", "learner_text"],
      "properties": {
        "tension_id": {"type": "string", "minLength": 1},
        "status": {"const": "unresolved"},
        "visual_equivalent": {"type": "string", "minLength": 1},
        "learner_text": {"type": "string", "minLength": 1}
      }
    },
    "entry_linkage": {"type": "object", "minProperties": 1},
    "repeated_appearance_parity": {"type": "object", "minProperties": 1},
    "provenance": {"type": "object", "minProperties": 1},
    "font_proof": {"type": "object", "minProperties": 1},
    "exact_reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_surface", "reconstructed_surface", "passed", "span_order"],
      "properties": {
        "expected_surface": {"type": "string", "minLength": 1},
        "reconstructed_surface": {"type": "string", "minLength": 1},
        "passed": {"const": true},
        "span_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "proof_points": {
      "type": "array",
      "minItems": 22,
      "items": {"type": "object", "required": ["id", "status", "witness"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "witness": {}}}
    },
    "live_mutation_allowed": {"const": false}
  }
}
