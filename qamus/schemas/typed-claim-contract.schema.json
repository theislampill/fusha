{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theIslampill/fusha/qamus/schemas/typed-claim-contract.schema.json",
  "title": "Governed typed-claim contract v1",
  "description": "Closed additive contract for typed facts that feed a learner projection. Candidate records do not certify linguistic truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "contract_id", "record_type", "canonical_occurrence", "facts", "projection"],
  "properties": {
    "schema": {"const": "qamus.typed_claim_contract.v1"},
    "contract_version": {"const": "1.0.0"},
    "contract_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1},
    "record_type": {"oneOf": [{"const": "projection_input"}, {"const": "unresolved_projection"}]},
    "canonical_occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["occurrence_id", "quran_loc", "wbw_loc", "surface", "surface_length"],
      "properties": {
        "occurrence_id": {"type": "string", "pattern": "^quran:[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
        "quran_loc": {"type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
        "wbw_loc": {"type": "string", "pattern": "^wbw:[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$"},
        "surface": {"type": "string", "minLength": 1},
        "surface_length": {"type": "integer"},
        "entry_id": {"type": "string", "minLength": 1},
        "card_id": {"type": "string", "minLength": 1}
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/governed_fact"}
    },
    "projection": {"$ref": "#/$defs/projection"},
    "tension_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/tension_record"}
    }
  },
  "$defs": {
    "fact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "surface_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "start", "end", "surface", "role"],
      "properties": {
        "span_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1},
        "start": {"type": "integer"},
        "end": {"type": "integer"},
        "surface": {"type": "string", "minLength": 1, "pattern": "^[^\\s]+$"},
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9_:-]*$"}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_id", "owner_type"],
      "properties": {
        "owner_id": {"type": "string", "minLength": 1},
        "owner_type": {"type": "string", "minLength": 1}
      }
    },
    "governed_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "fact_type",
        "fact_value",
        "surface_spans",
        "ownership",
        "source",
        "source_address",
        "certification",
        "evidence",
        "evidence_mode",
        "source_evidence",
        "derivation_chain",
        "dependencies",
        "contradiction_records",
        "producer",
        "rule_projector",
        "guards",
        "defeaters",
        "unresolved_blockers",
        "dependent_fact_ids",
        "dependent_projection_ids"
      ],
      "properties": {
        "fact_id": {"$ref": "#/$defs/fact_id"},
        "fact_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "minLength": 1},
        "fact_value": {"type": "object", "minProperties": 1},
        "surface_spans": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/surface_span"}
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "secondary"],
          "properties": {
            "primary": {"$ref": "#/$defs/owner"},
            "secondary": {"type": "array", "items": {"$ref": "#/$defs/owner"}}
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "source_kind"],
          "properties": {
            "source_id": {"type": "string", "minLength": 1},
            "source_kind": {"type": "string", "enum": ["quran_token", "qamus_entry_field", "corpus_record", "construction", "review_artifact"]}
          }
        },
        "source_address": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "source_kind"],
          "properties": {
            "address": {"type": "string", "minLength": 1},
            "source_kind": {"type": "string", "enum": ["quran_token", "qamus_entry_field", "corpus_record", "construction", "review_artifact"]}
          }
        },
        "certification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"type": "string", "enum": ["candidate", "review_required", "certified", "pending", "blocked", "rejected"]},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "confidence", "evidence_ids", "summary"],
          "properties": {
            "status": {"type": "string", "enum": ["unknown", "observed", "source_addressed_candidate", "two_vote", "certified", "blocked"]},
            "confidence": {"type": "string", "enum": ["unknown", "low", "medium", "high"]},
            "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "summary": {"type": "string", "minLength": 1}
          }
        },
        "evidence_mode": {"$ref": "#/$defs/evidence_mode"},
        "source_evidence": {"$ref": "#/$defs/source_evidence"},
        "derivation_chain": {
          "type": "array",
          "items": {"$ref": "#/$defs/derivation_step"}
        },
        "dependencies": {"$ref": "#/$defs/dependencies"},
        "contradiction_records": {
          "type": "array",
          "items": {"$ref": "#/$defs/contradiction_record"}
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "rule_projector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule_id", "projector_id", "version"],
          "properties": {
            "rule_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1},
            "projector_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
          }
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["guard_id", "reason"],
            "properties": {
              "guard_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "defeaters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defeater_id", "reason", "fact_ids"],
            "properties": {
              "defeater_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1},
              "fact_ids": {"type": "array", "items": {"$ref": "#/$defs/fact_id"}}
            }
          }
        },
        "unresolved_blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blocker_id", "reason"],
            "properties": {
              "blocker_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "dependent_fact_ids": {"type": "array", "items": {"$ref": "#/$defs/fact_id"}},
        "dependent_projection_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "evidence_mode": {
      "type": "string",
      "enum": [
        "direct_source_attestation",
        "cross_source_corroboration",
        "deterministic_derivation_from_certified_facts",
        "paired_form_inference",
        "normalized_lexical_body",
        "owner_or_scholar_adjudication",
        "unresolved"
      ]
    },
    "source_address_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "source_kind"],
      "properties": {
        "address": {"type": "string", "minLength": 1},
        "source_kind": {"type": "string", "enum": ["quran_token", "qamus_entry_field", "corpus_record", "construction", "review_artifact"]}
      }
    },
    "source_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_addresses"],
      "properties": {
        "source_addresses": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_address_ref"}
        },
        "source_quotation": {"type": "string", "minLength": 1},
        "structured_source_fact": {"type": "object", "minProperties": 1}
      },
      "oneOf": [
        {"required": ["source_quotation"]},
        {"required": ["structured_source_fact"]}
      ]
    },
    "derivation_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "operation", "input_fact_ids", "input_source_addresses", "output"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1},
        "input_fact_ids": {"type": "array", "items": {"$ref": "#/$defs/fact_id"}},
        "input_source_addresses": {"type": "array", "items": {"$ref": "#/$defs/source_address_ref"}},
        "output": {"type": "string", "minLength": 1}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_ids", "source_addresses"],
      "properties": {
        "fact_ids": {"type": "array", "items": {"$ref": "#/$defs/fact_id"}},
        "source_addresses": {"type": "array", "items": {"$ref": "#/$defs/source_address_ref"}}
      }
    },
    "contradiction_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tension_id", "relation", "note"],
      "properties": {
        "tension_id": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "enum": ["attached_unresolved", "contradicts", "qualifies"]},
        "note": {"type": "string", "minLength": 1}
      }
    },
    "tension_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tension_id", "status", "statement", "fact_ids", "resolution_requirement"],
      "properties": {
        "tension_id": {"type": "string", "minLength": 1},
        "status": {"type": "string", "enum": ["unresolved", "review_required", "resolved"]},
        "statement": {"type": "string", "minLength": 1},
        "fact_ids": {"type": "array", "items": {"$ref": "#/$defs/fact_id"}},
        "resolution_requirement": {"type": "string", "minLength": 1}
      }
    },
    "materialization_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "field", "public_materialization_allowed", "live_mutation_allowed"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "field": {"type": "string", "minLength": 1},
        "public_materialization_allowed": {"const": false},
        "live_mutation_allowed": {"const": false}
      }
    },
    "claim_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "fact_field", "surface_span_ids"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/fact_id"},
        "fact_field": {"type": "string", "pattern": "^[A-Za-z0-9_.\\[\\]-]+$", "minLength": 1},
        "surface_span_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection_id", "status", "unresolved_status", "learner_visible", "materialization_target", "claim"],
      "properties": {
        "projection_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "minLength": 1},
        "status": {"type": "string", "enum": ["candidate", "unresolved", "source_gap", "producer_pending", "syntax_pending", "blocked"]},
        "unresolved_status": {"type": ["string", "null"], "enum": ["unresolved", "source_gap", "producer_pending", "syntax_pending", "blocked", null]},
        "learner_visible": {"type": "boolean"},
        "materialization_target": {"$ref": "#/$defs/materialization_target"},
        "claim": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["text", "language", "fact_bindings"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "language": {"const": "en"},
            "fact_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim_binding"}}
          }
        },
        "learner_statement": {"type": ["string", "null"]},
        "public_payload": {"type": "object"}
      }
    }
  }
}
