{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theIslampill/fusha/qamus/schemas/tranche1-projection-crosswalk.schema.json",
  "title": "Tranche 1 fixture projection crosswalk",
  "description": "Closed fixture-only lineage carrier joining one exact source observation to either a candidate public projection or a typed unresolved queue row. This schema does not authorize live materialization.",
  "type": "object",
  "required": [
    "schema",
    "record_type",
    "canary_id",
    "quran_loc",
    "wbw_loc",
    "surface",
    "fact_ids",
    "status",
    "source_address",
    "source_row_hash",
    "source_commit",
    "materialization_target",
    "producer",
    "projector_id",
    "version",
    "output_artifact",
    "output_row_hash",
    "field_mappings",
    "blocker",
    "route",
    "live_mutation_allowed"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "qamus.tranche1_projection_crosswalk.v1" },
    "record_type": { "type": "string", "enum": ["candidate_projection", "typed_queue_record"] },
    "canary_id": { "type": "string", "pattern": "^tranche1:[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$" },
    "quran_loc": { "type": "string", "pattern": "^[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$" },
    "wbw_loc": { "type": "string", "pattern": "^wbw:[0-9]{1,3}:[0-9]{1,3}:[0-9]{1,3}$" },
    "surface": { "type": "string", "minLength": 1 },
    "fact_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "unresolved", "source_gap", "producer_pending", "syntax_pending"]
    },
    "source_address": {
      "type": "object",
      "required": ["address", "source_kind"],
      "additionalProperties": false,
      "properties": {
        "address": { "type": "string", "minLength": 1 },
        "source_kind": { "const": "quran_token" }
      }
    },
    "source_row_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "materialization_target": {
      "type": "object",
      "required": ["artifact", "field", "public_materialization_allowed", "live_mutation_allowed"],
      "additionalProperties": false,
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "public_materialization_allowed": { "const": false },
        "live_mutation_allowed": { "const": false }
      }
    },
    "producer": { "type": "string", "minLength": 1 },
    "projector_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "output_artifact": { "type": "string", "minLength": 1 },
    "output_row_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "field_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_index",
          "source_gloss_field",
          "source_class_field",
          "public_gloss_field",
          "public_class_field",
          "gloss",
          "qg_class"
        ],
        "additionalProperties": false,
        "properties": {
          "segment_index": { "type": "integer", "minimum": 0 },
          "source_gloss_field": { "const": "gloss_contribution" },
          "source_class_field": { "const": "class" },
          "public_gloss_field": { "const": "gloss" },
          "public_class_field": { "const": "qg_class" },
          "gloss": { "type": "string", "minLength": 1 },
          "qg_class": { "type": "string", "pattern": "^qg-[a-z0-9-]+$" }
        }
      }
    },
    "blocker": { "type": ["string", "null"] },
    "route": {
      "type": ["object", "null"],
      "required": ["lane", "procedure"],
      "additionalProperties": false,
      "properties": {
        "lane": { "type": "string", "enum": ["sarf", "nahw", "validator", "owner_review", "scholar_irab_review"] },
        "procedure": { "type": "string", "minLength": 1 }
      }
    },
    "live_mutation_allowed": { "const": false }
  }
}
