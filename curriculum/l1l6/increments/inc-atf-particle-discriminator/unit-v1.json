  "rules": [
    {
      "id": "atf-r1",
      "text": "particle identity, position relative to the two terms, case identity, polarity of the preceding clause, the size of the following unit and gemination are SUPPLIED evidence, never guessed from the bare form"
    },
    {
      "id": "atf-r2",
      "text": "case transmission from the first term to the second is the formal content of the coordination relation; a second term with an independent governor is not a conjunct"
    },
    {
      "id": "atf-r3",
      "text": "position between two terms separates the coordinating negator from clause negation, and gemination separates the adversative coordinator from its governing homograph"
    },
    {
      "id": "atf-r4",
      "text": "the disputed members carry an attributed no-decision path: when both the coordinating and the governing reading are licensed, both are kept with their attribution and neither is promoted"
    },
    {
      "id": "atf-r5",
      "text": "the classical division of the two alternation particles by clause type is recorded as taught; looser later usage is a teaching note and is never emitted as a licensing rule"
