{
  "abstention_reasons": [
    "missing_pedagogical_inputs"
  ],
  "capability": "pedagogical_projection",
  "increment": "inc-pedagogy",
  "projection_contract": {
    "emits": [
      {
        "field": "prerequisite_statement",
        "from": "prerequisites"
      },
      {
        "field": "beginner_explanation",
        "from": "purpose"
      },
      {
        "field": "intermediate_explanation",
        "from": "procedure"
      },
      {
        "field": "advanced_explanation",
        "from": "conditions_exceptions"
      },
      {
        "field": "technical_identity",
        "from": "fact_ref",
        "prefix": "unit:"
      },
      {
        "field": "recognition_cue",
        "from": "recognition"
      },
      {
        "field": "common_error_warning",
        "from": "error_warning",
        "prefix": "watch out: "
      },
      {
        "field": "contrast_or_transfer",
        "from": "contrast"
      },
      {
        "field": "unresolved_notice",
        "from": "rival_notice"
      },
      {
        "field": "tutor_destination",
        "from": "destination"
      }
    ],
    "required": [
      "fact_ref",
      "purpose",
      "recognition"
    ]
  },
  "rules": [
    {
      "id": "ped-r1",
      "text": "teaching artifacts are compiled from the qualified unit's declared inputs; missing required evidence abstains — content is never invented"
    },
    {
      "id": "ped-r2",
      "text": "the fact_ref is carried verbatim (technical_identity): learner-level simplification can never overwrite the underlying fact"
    },
    {
      "id": "ped-r3",
      "text": "where a unit carries uncertainty/rival flags, the projection MUST surface the unresolved notice (v1; the v0 defect drops it)"
    }
  ],
  "schema": "curriculum.l1l6_machine_unit.v1",
  "status": "candidate",
  "unit_ref": "u-n12",
